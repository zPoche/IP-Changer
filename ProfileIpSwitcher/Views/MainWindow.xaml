<mah:MetroWindow x:Class="ProfileIpSwitcher.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:models="clr-namespace:ProfileIpSwitcher.Models"
                 xmlns:c="clr-namespace:ProfileIpSwitcher.Converters"
                 Title="ProfileIpSwitcher"
                 Height="640"
                 Width="980"
                 WindowStartupLocation="CenterScreen"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <mah:MetroWindow.Resources>
        <c:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </mah:MetroWindow.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="Profile _exportieren…" Command="{Binding ExportCommand}" />
                <MenuItem Header="Profile _importieren…" Command="{Binding ImportCommand}" />
                <Separator />
                <MenuItem Header="_Beenden" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Extras">
                <MenuItem Header="_Einstellungen…" Command="{Binding OpenSettingsCommand}" />
                <MenuItem Header="Nach _Updates suchen…" Command="{Binding CheckUpdatesCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Height="28">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentTime}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock>
                    <Run Text="Adapter: " />
                    <Run Text="{Binding SelectedStatusAdapter.Name, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem Content="{Binding LastOperation}" />
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBox DockPanel.Dock="Top"
                         mah:TextBoxHelper.Watermark="Suche…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,8" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,8,0,0">
                    <UniformGrid Columns="2" Margin="0,0,0,4">
                        <Button Content="Neu" Command="{Binding NewProfileCommand}" Margin="0,0,4,4" />
                        <Button Content="Duplizieren" Command="{Binding DuplicateProfileCommand}" Margin="4,0,0,4" />
                        <Button Content="Löschen" Command="{Binding DeleteProfileCommand}" Margin="0,0,4,0" />
                        <Button Content="★ Favorit" Command="{Binding ToggleFavoriteCommand}" Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>
                <ListBox ItemsSource="{Binding FilteredProfiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         BorderThickness="1">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDoubleClick">
                            <b:InvokeCommandAction Command="{Binding ApplyProfileDoubleClickCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NetworkProfile}">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="★"
                                           FontSize="16"
                                           Margin="0,0,6,0"
                                           Foreground="Gold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock FontSize="11"
                                              Opacity="0.7"
                                              Text="{Binding AdapterInterfaceId}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Aktueller Adapter (Live)"
                               FontSize="18"
                               FontWeight="Light"
                               Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox Width="360"
                                  ItemsSource="{Binding Adapters}"
                                  DisplayMemberPath="DisplayLine"
                                  SelectedItem="{Binding SelectedStatusAdapter}" />
                        <Button Content="Aktualisieren"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshAdaptersCommand}" />
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,16">
                        <Run Text="Status: " FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedStatusAdapter.OperationalStatus, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="IPv4: " FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedStatusAdapter.Ipv4, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="Maske: " FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedStatusAdapter.SubnetMask, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="Gateway: " FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedStatusAdapter.Gateway, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="DNS: " FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedStatusAdapter.DnsServers, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="DHCP: " FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedStatusAdapter.DhcpEnabled, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="Netzwerkprofil: " FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedStatusAdapter.NetworkCategory, Mode=OneWay}" />
                        <LineBreak />
                        <Run Text="WLAN-SSID: " FontWeight="SemiBold" />
                        <Run Text="{Binding SelectedStatusAdapter.WifiSsid, Mode=OneWay}" />
                    </TextBlock>

                    <Separator Margin="0,0,0,16" />

                    <TextBlock Text="Profil (Vorschau)"
                               FontSize="18"
                               FontWeight="Light"
                               Margin="0,0,0,8" />
                    <TextBox Text="{Binding ProfileDetails, Mode=OneWay}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             MinHeight="120"
                             Margin="0,0,0,8" />

                    <Button Content="Profil bearbeiten…"
                            Command="{Binding EditProfileCommand}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16" />

                    <TextBlock TextWrapping="Wrap"
                               Foreground="OrangeRed"
                               Margin="0,0,0,8"
                               Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVis}}">
                        Keine Administratorrechte: „Profil anwenden“ ist deaktiviert.
                    </TextBlock>

                    <Button Content="Profil anwenden"
                            Command="{Binding ApplyProfileCommand}"
                            FontSize="16"
                            Padding="16,10"
                            HorizontalAlignment="Right"
                            Style="{DynamicResource MahApps.Styles.Button.MetroAccent}"
                            IsEnabled="{Binding CanApply}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
