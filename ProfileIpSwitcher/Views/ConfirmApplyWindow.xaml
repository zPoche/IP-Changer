<mah:MetroWindow x:Class="ProfileIpSwitcher.Views.ConfirmApplyWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Profil anwenden"
                 Height="220"
                 Width="420"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   FontSize="14" />
        <CheckBox x:Name="DontAskCheckBox"
                  Grid.Row="1"
                  Content="Nicht wieder nachfragen"
                  VerticalAlignment="Top"
                  Margin="0,0,0,12" />
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Abbrechen"
                    Width="100"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button Content="Anwenden"
                    Width="100"
                    IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
