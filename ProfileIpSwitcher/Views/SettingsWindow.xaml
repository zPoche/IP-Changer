<mah:MetroWindow x:Class="ProfileIpSwitcher.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Einstellungen"
                 Height="420"
                 Width="480"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <CheckBox Content="Mit Windows starten"
                      IsChecked="{Binding StartWithWindows}"
                      Margin="0,0,0,8" />
            <CheckBox Content="Beim Schließen ins Infobereich-Symbol minimieren (statt beenden)"
                      IsChecked="{Binding MinimizeToTrayInsteadOfClose}"
                      Margin="0,0,0,8" />
            <CheckBox Content="Beim Start auf Updates prüfen"
                      IsChecked="{Binding CheckForUpdatesOnStartup}"
                      Margin="0,0,0,8" />
            <CheckBox Content="Beim Doppelklick auf ein Profil nicht nachfragen"
                      IsChecked="{Binding SkipDoubleClickApplyConfirmation}"
                      Margin="0,0,0,16" />
            <TextBlock Text="URL für Update-Check (Platzhalter)" Margin="0,0,0,4" />
            <TextBox Text="{Binding UpdateCheckUrl, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />
            <TextBlock Text="GitHub-Releases-Seite" Margin="0,0,0,4" />
            <TextBox Text="{Binding GitHubReleasesUrl, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Abbrechen"
                    Width="100"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button Content="OK"
                    Width="100"
                    IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
