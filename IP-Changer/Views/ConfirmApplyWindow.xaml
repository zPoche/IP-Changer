<mah:MetroWindow x:Class="ProfileIpSwitcher.Views.ConfirmApplyWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Profil anwenden"
                 TitleCharacterCasing="Normal"
                 Height="230"
                 Width="440"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   FontSize="14" />
        <CheckBox x:Name="DontAskCheckBox"
                  Grid.Row="1"
                  Content="Nicht wieder nachfragen"
                  VerticalAlignment="Top"
                  Margin="0,0,0,12" />
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,4,0,0">
            <Button Content="Abbrechen"
                    MinWidth="100"
                    Margin="0,0,10,0"
                    Padding="14,8"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button Content="Anwenden"
                    MinWidth="100"
                    Padding="14,8"
                    Style="{DynamicResource App.Button.Accent}"
                    IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
