<mah:MetroWindow x:Class="ProfileIpSwitcher.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Title="Einstellungen"
                 TitleCharacterCasing="Normal"
                 Height="430"
                 Width="500"
                 WindowStartupLocation="CenterOwner"
                 ResizeMode="NoResize"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <Grid Margin="20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <CheckBox Content="Mit Windows starten"
                      IsChecked="{Binding StartWithWindows}"
                      Margin="0,0,0,8" />
            <CheckBox Content="Beim Schließen ins Infobereich-Symbol minimieren (statt beenden)"
                      IsChecked="{Binding MinimizeToTrayInsteadOfClose}"
                      Margin="0,0,0,8" />
            <CheckBox Content="Beim Start auf Updates prüfen"
                      IsChecked="{Binding CheckForUpdatesOnStartup}"
                      Margin="0,0,0,8" />
            <CheckBox Content="Beim Doppelklick auf ein Profil nicht nachfragen"
                      IsChecked="{Binding SkipDoubleClickApplyConfirmation}"
                      Margin="0,0,0,16" />
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
                Update-Quelle: GitHub-Repo (z. B. https://github.com/Benutzer/IP-Changer) oder direkte JSON-URL
            </TextBlock>
            <TextBox Text="{Binding UpdateCheckUrl, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" />
            <TextBlock Text="Releases-Seite (Link „Im Browser öffnen“)" Margin="0,0,0,4" />
            <TextBox Text="{Binding GitHubReleasesUrl, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Abbrechen"
                    MinWidth="100"
                    Margin="0,0,10,0"
                    Padding="14,8"
                    IsCancel="True"
                    Click="Cancel_Click" />
            <Button Content="OK"
                    MinWidth="100"
                    Padding="14,8"
                    Style="{DynamicResource App.Button.Accent}"
                    IsDefault="True"
                    Click="Ok_Click" />
        </StackPanel>
    </Grid>
</mah:MetroWindow>
