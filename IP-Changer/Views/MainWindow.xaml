<mah:MetroWindow x:Class="ProfileIpSwitcher.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                 xmlns:models="clr-namespace:ProfileIpSwitcher.Models"
                 xmlns:c="clr-namespace:ProfileIpSwitcher.Converters"
                 Title="IP-Changer"
                 TitleCharacterCasing="Normal"
                 Height="720"
                 Width="1020"
                 MinHeight="560"
                 MinWidth="880"
                 WindowState="Normal"
                 ShowInTaskbar="True"
                 Visibility="Visible"
                 WindowStartupLocation="CenterScreen"
                 GlowBrush="{DynamicResource MahApps.Brushes.Accent}">
    <mah:MetroWindow.Resources>
        <c:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <c:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.78" />
            <Setter Property="Margin" Value="0,0,14,8" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ProfileListBox" TargetType="ListBox" BasedOn="{StaticResource MahApps.Styles.ListBox}">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.Gray7}" />
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </mah:MetroWindow.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Datei">
                <MenuItem Header="Profile _exportieren…" Command="{Binding ExportCommand}" />
                <MenuItem Header="Profile _importieren…" Command="{Binding ImportCommand}" />
                <Separator />
                <MenuItem Header="_Beenden" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Extras">
                <MenuItem Header="_Einstellungen…" Command="{Binding OpenSettingsCommand}" />
                <MenuItem Header="Nach _Updates suchen…" Command="{Binding CheckUpdatesCommand}" />
                <Separator />
                <MenuItem Header="_Info…" Command="{Binding OpenAboutCommand}" />
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom"
                   MinHeight="30"
                   Background="{DynamicResource MahApps.Brushes.Gray10}"
                   BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding CurrentTime}" FontSize="12" Opacity="0.9" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock FontSize="12">
                    <Run Text="Adapter: "
                         Foreground="{DynamicResource MahApps.Brushes.Gray2}" />
                    <Run Text="{Binding SelectedStatusAdapter.Name, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding LastOperation}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="520" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="14,10,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBox DockPanel.Dock="Top"
                         mah:TextBoxHelper.Watermark="Profile oder Adapter suchen…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Margin="0,10,0,0">
                    <UniformGrid Columns="2" Margin="0,0,0,0">
                        <Button Content="Neu"
                                Command="{Binding NewProfileCommand}"
                                Margin="0,0,5,6"
                                Padding="10,6" />
                        <Button Content="Duplizieren"
                                Command="{Binding DuplicateProfileCommand}"
                                Margin="5,0,0,6"
                                Padding="10,6" />
                        <Button Content="Löschen"
                                Command="{Binding DeleteProfileCommand}"
                                Margin="0,0,5,0"
                                Padding="10,6" />
                        <Button Content="★ Favorit"
                                Command="{Binding ToggleFavoriteCommand}"
                                Margin="5,0,0,0"
                                Padding="10,6" />
                    </UniformGrid>
                </StackPanel>
                <ListBox ItemsSource="{Binding FilteredProfiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Style="{StaticResource ProfileListBox}">
                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="MouseDoubleClick">
                            <b:InvokeCommandAction Command="{Binding ApplyProfileDoubleClickCommand}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NetworkProfile}">
                            <Grid Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="★"
                                           FontSize="16"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"
                                           Foreground="Gold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock FontSize="11.5"
                                               Opacity="0.68"
                                               Text="{Binding AdapterListSubtitle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <TabControl Grid.Column="1">
                <TabItem Header="Übersicht">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Live-Adapter -->
                            <Border Style="{StaticResource App.SectionCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource App.SectionTitleRow}">
                                        <Border Width="4"
                                                Height="22"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                Background="{DynamicResource MahApps.Brushes.Accent}" />
                                        <TextBlock Text="Aktueller Adapter (Live)"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <ComboBox Width="380"
                                                  MinWidth="200"
                                                  ItemsSource="{Binding Adapters}"
                                                  DisplayMemberPath="DisplayLine"
                                                  SelectedItem="{Binding SelectedStatusAdapter}" />
                                        <Button Content="Aktualisieren"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center"
                                                Padding="14,8"
                                                Command="{Binding RefreshAdaptersCommand}" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="132" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LiveOperationalStatus, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="IPv4" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LiveIpv4, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <Button Grid.Row="1" Grid.Column="2"
                                                Content="Kopieren"
                                                Command="{Binding CopyTextCommand}"
                                                CommandParameter="{Binding LiveIpv4}"
                                                Margin="10,0,0,8"
                                                Padding="10,3" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Subnetzmaske" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LiveSubnetMask, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <Button Grid.Row="2" Grid.Column="2"
                                                Content="Kopieren"
                                                Command="{Binding CopyTextCommand}"
                                                CommandParameter="{Binding LiveSubnetMask}"
                                                Margin="10,0,0,8"
                                                Padding="10,3" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Gateway" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LiveGateway, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <Button Grid.Row="3" Grid.Column="2"
                                                Content="Kopieren"
                                                Command="{Binding CopyTextCommand}"
                                                CommandParameter="{Binding LiveGateway}"
                                                Margin="10,0,0,8"
                                                Padding="10,3" />
                                        <Button Grid.Row="3" Grid.Column="3"
                                                Content="Ping"
                                                Command="{Binding PingAddressCommand}"
                                                CommandParameter="{Binding LiveGateway}"
                                                Margin="8,0,0,8"
                                                Padding="10,3" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="DNS" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding LiveDns, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <Button Grid.Row="4" Grid.Column="2"
                                                Content="Kopieren"
                                                Command="{Binding CopyTextCommand}"
                                                CommandParameter="{Binding LiveDns}"
                                                Margin="10,0,0,8"
                                                Padding="10,3" />
                                        <Button Grid.Row="4" Grid.Column="3"
                                                Content="Ping"
                                                Command="{Binding PingAddressCommand}"
                                                CommandParameter="{Binding LiveDns}"
                                                Margin="8,0,0,8"
                                                Padding="10,3" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="DHCP" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LiveDhcp, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Netzwerkprofil" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding LiveNetworkCategory, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="WLAN-SSID" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LiveWifiSsid, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Profil-Vorschau -->
                            <Border Style="{StaticResource App.SectionCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource App.SectionTitleRow}">
                                        <Border Width="4"
                                                Height="22"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                Background="{DynamicResource MahApps.Brushes.Accent}" />
                                        <TextBlock Text="Profil (Vorschau)"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Text="Wählen Sie links ein Profil aus oder legen Sie ein neues an."
                                               TextWrapping="Wrap"
                                               Opacity="0.65"
                                               Margin="0,8,0,12"
                                               Visibility="{Binding HasSelectedProfile, Converter={StaticResource InverseBoolToVis}}" />

                                    <Grid Visibility="{Binding HasSelectedProfile, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="132" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProfilePreviewName, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Beschreibung" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfilePreviewDescription, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Adapter" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfilePreviewAdapter, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Modus" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProfilePreviewMode, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="IPv4" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProfilePreviewIpv4, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <Button Grid.Row="4" Grid.Column="2"
                                                Content="Kopieren"
                                                Command="{Binding CopyTextCommand}"
                                                CommandParameter="{Binding ProfilePreviewIpv4}"
                                                Margin="10,0,0,8"
                                                Padding="10,3" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Subnetzmaske" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ProfilePreviewSubnet, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <Button Grid.Row="5" Grid.Column="2"
                                                Content="Kopieren"
                                                Command="{Binding CopyTextCommand}"
                                                CommandParameter="{Binding ProfilePreviewSubnet}"
                                                Margin="10,0,0,8"
                                                Padding="10,3" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Gateway" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ProfilePreviewGateway, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <Button Grid.Row="6" Grid.Column="2"
                                                Content="Kopieren"
                                                Command="{Binding CopyTextCommand}"
                                                CommandParameter="{Binding ProfilePreviewGateway}"
                                                Margin="10,0,0,8"
                                                Padding="10,3" />
                                        <Button Grid.Row="6" Grid.Column="3"
                                                Content="Ping"
                                                Command="{Binding PingAddressCommand}"
                                                CommandParameter="{Binding ProfilePreviewGateway}"
                                                Margin="8,0,0,8"
                                                Padding="10,3" />
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="DNS" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ProfilePreviewDns, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                        <Button Grid.Row="7" Grid.Column="2"
                                                Content="Kopieren"
                                                Command="{Binding CopyTextCommand}"
                                                CommandParameter="{Binding ProfilePreviewDns}"
                                                Margin="10,0,0,8"
                                                Padding="10,3" />
                                        <Button Grid.Row="7" Grid.Column="3"
                                                Content="Ping"
                                                Command="{Binding PingAddressCommand}"
                                                CommandParameter="{Binding ProfilePreviewDns}"
                                                Margin="8,0,0,8"
                                                Padding="10,3" />
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Favorit" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ProfilePreviewFavorite, Mode=OneWay}" Style="{StaticResource DetailValueStyle}" />
                                    </Grid>

                                    <Button Content="Profil bearbeiten…"
                                            Command="{Binding EditProfileCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,16,0,0"
                                            Padding="14,8" />
                                </StackPanel>
                            </Border>

                            <!-- Anwenden -->
                            <Border Style="{StaticResource App.SectionCard}" Margin="0,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock TextWrapping="Wrap"
                                                   Foreground="OrangeRed"
                                                   Margin="0,0,0,8"
                                                   Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVis}}">
                                            Keine Administratorrechte: „Profil anwenden“ ist deaktiviert.
                                        </TextBlock>
                                        <TextBlock Text="Profil auf den gewählten Live-Adapter anwenden (netsh)."
                                                   Opacity="0.7"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0">
                                        <mah:ProgressRing Width="36"
                                                          Height="36"
                                                          Margin="0,0,14,0"
                                                          IsActive="{Binding IsBusy}"
                                                          Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        <Button Content="Profil anwenden"
                                                Command="{Binding ApplyProfileCommand}"
                                                FontSize="15"
                                                MinWidth="200"
                                                Padding="22,12"
                                                VerticalAlignment="Center"
                                                Style="{DynamicResource App.Button.Accent}"
                                                IsEnabled="{Binding CanApply}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Werkzeuge">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource App.SectionCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource App.SectionTitleRow}">
                                        <Border Width="4"
                                                Height="22"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                Background="{DynamicResource MahApps.Brushes.Accent}" />
                                        <TextBlock Text="IP-Ping"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding PingTarget, UpdateSourceTrigger=PropertyChanged}"
                                                 mah:TextBoxHelper.Watermark="IPv4 (z. B. 8.8.8.8)"
                                                 Margin="0,0,10,8" />
                                        <Button Grid.Column="1"
                                                Content="Ping starten"
                                                Command="{Binding PingCommand}"
                                                IsEnabled="{Binding CanPing}"
                                                Padding="14,6"
                                                Margin="0,0,10,8" />
                                        <mah:ProgressRing Grid.Column="2"
                                                          Width="24"
                                                          Height="24"
                                                          IsActive="{Binding IsPinging}"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,0,8"
                                                          Visibility="{Binding IsPinging, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding PingResult, Mode=OneWay}"
                                               Opacity="0.75"
                                               Margin="0,0,0,2"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource App.SectionCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource App.SectionTitleRow}">
                                        <Border Width="4"
                                                Height="22"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                Background="{DynamicResource MahApps.Brushes.Accent}" />
                                        <TextBlock Text="Portscanner (TCP)"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Host / IPv4" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding PortScanTarget, UpdateSourceTrigger=PropertyChanged}"
                                                 mah:TextBoxHelper.Watermark="z. B. 192.168.1.10 oder localhost"
                                                 Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ports" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding PortScanPorts, UpdateSourceTrigger=PropertyChanged}"
                                                 mah:TextBoxHelper.Watermark="z. B. 22,80,443 oder 8000-8010" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Portscan starten"
                                                Command="{Binding PortScanCommand}"
                                                IsEnabled="{Binding CanPortScan}"
                                                Padding="14,6" />
                                        <mah:ProgressRing Width="24"
                                                          Height="24"
                                                          IsActive="{Binding IsPortScanning}"
                                                          VerticalAlignment="Center"
                                                          Margin="10,0,0,0"
                                                          Visibility="{Binding IsPortScanning, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding PortScanResult, Mode=OneWay}"
                                               Opacity="0.75"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource App.SectionCard}">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource App.SectionTitleRow}">
                                        <Border Width="4"
                                                Height="22"
                                                CornerRadius="2"
                                                VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                Background="{DynamicResource MahApps.Brushes.Accent}" />
                                        <TextBlock Text="Wake-on-LAN"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="MAC-Adresse" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBox Grid.Row="0" Grid.Column="1"
                                                 Text="{Binding WakeOnLanMac, UpdateSourceTrigger=PropertyChanged}"
                                                 mah:TextBoxHelper.Watermark="z. B. 00:11:22:33:44:55"
                                                 Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Broadcast" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBox Grid.Row="1" Grid.Column="1"
                                                 Text="{Binding WakeOnLanBroadcast, UpdateSourceTrigger=PropertyChanged}"
                                                 mah:TextBoxHelper.Watermark="z. B. 192.168.1.255"
                                                 Margin="0,0,0,8" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="UDP-Port" Style="{StaticResource DetailLabelStyle}" />
                                        <TextBox Grid.Row="2" Grid.Column="1"
                                                 Text="{Binding WakeOnLanPort, UpdateSourceTrigger=PropertyChanged}"
                                                 mah:TextBoxHelper.Watermark="z. B. 9" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Magic Packet senden"
                                                Command="{Binding WakeOnLanCommand}"
                                                IsEnabled="{Binding CanWakeOnLan}"
                                                Padding="14,6" />
                                        <mah:ProgressRing Width="24"
                                                          Height="24"
                                                          IsActive="{Binding IsSendingWakeOnLan}"
                                                          VerticalAlignment="Center"
                                                          Margin="10,0,0,0"
                                                          Visibility="{Binding IsSendingWakeOnLan, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding WakeOnLanResult, Mode=OneWay}"
                                               Opacity="0.75"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
