<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- SemVer; GitHub-Release-Tag z. B. v1.0.1 -->
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ProfileIpSwitcher</RootNamespace>
    <AssemblyName>ProfileIpSwitcher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon />

    <!--
      Portable Single-File (self-contained) für Windows x64:
      - PublishSingleFile: eine EXE (plus ggf. kleine Extrakt-Hilfe beim ersten Start).
      - SelfContained: .NET-Runtime wird mitgeliefert → auf Ziel-PC keine separate Runtime nötig.
      - RuntimeIdentifier win-x64: festes Ziel; Build/Publish landen unter …/win-x64/ (auch bei dotnet build).
      - PublishTrimmed false: WPF/XAML bricht mit Trimming oft; absichtlich aus.
      - IncludeNativeLibrariesForSelfExtract: native DLLs in die Single-File-Bündelung für Selbstextraktion.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="System.Management" Version="10.0.5" />
  </ItemGroup>

</Project>
